// ===============================================================
// Assumed Data Model
// ===============================================================
// Collection: games
// Document ID: an 8-character lobby code.
// Fields: code (immutable string), status (WAITING or SETUP), ownerId and
// playerOneId (immutable creator UID), playerTwoId (nullable UID, set once),
// createdAt (immutable timestamp), updatedAt (server timestamp).
// Player colours are intentionally absent: they are assigned in a future game
// setup flow, after both players have joined.
// ===============================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function isParticipant(data) { return isAuthenticated() && ((data.keys().hasAll(['playerOneId', 'playerTwoId']) && (data.playerOneId == request.auth.uid || data.playerTwoId == request.auth.uid)) || (data.keys().hasAll(['redPlayerId', 'bluePlayerId']) && (data.redPlayerId == request.auth.uid || data.bluePlayerId == request.auth.uid))); }
    function hasRequiredFields(data) { return data.keys().hasAll(['code', 'status', 'ownerId', 'playerOneId', 'playerOneName', 'playerTwoId', 'playerTwoName', 'createdAt', 'updatedAt']); }
    function isValidUid(value) { return value is string && value.size() > 0 && value.size() <= 128; }
    function isLobbyCode(code) { return code is string && code.size() == 8 && code.matches('^[A-Z0-9]+$'); }
    function isValidGame(data) {
      return hasRequiredFields(data) &&
        data.keys().hasOnly(['code', 'status', 'ownerId', 'playerOneId', 'playerOneName', 'playerTwoId', 'playerTwoName', 'createdAt', 'updatedAt']) &&
        isLobbyCode(data.code) && data.status in ['WAITING', 'SETUP'] &&
        isValidUid(data.ownerId) && data.playerOneId == data.ownerId && data.playerOneName is string && data.playerOneName.size() > 0 && data.playerOneName.size() <= 64 &&
        ((data.playerTwoId == null && data.playerTwoName == null) || (isValidUid(data.playerTwoId) && data.playerTwoName is string && data.playerTwoName.size() > 0 && data.playerTwoName.size() <= 64)) &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    match /games/{gameCode} {
      // An authenticated invitee may read one waiting lobby to perform the
      // atomic join transaction. Listing remains participant-only.
      allow get: if isAuthenticated() && (resource.data.status == 'WAITING' || isParticipant(resource.data));
      allow list: if isParticipant(resource.data);
      allow create: if isOwner(request.resource.data.ownerId) &&
        request.resource.data.code == gameCode && request.resource.data.playerOneId == request.auth.uid &&
        request.resource.data.playerTwoId == null && request.resource.data.playerTwoName == null && request.resource.data.status == 'WAITING' &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time &&
        isValidGame(request.resource.data);
      allow update: if isAuthenticated() && resource.data.status == 'WAITING' && resource.data.playerTwoId == null &&
        request.resource.data.playerTwoId == request.auth.uid && request.resource.data.status == 'SETUP' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerTwoId', 'playerTwoName', 'status', 'updatedAt']) && request.resource.data.updatedAt == request.time && isValidGame(request.resource.data)
        || isAuthenticated() && resource.data.playerTwoId == request.auth.uid && request.resource.data.status == 'SETUP' && request.resource.data.playerOneId == resource.data.playerOneId && request.resource.data.playerTwoId == null && request.resource.data.playerTwoName == null && request.resource.data.status == 'WAITING' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerTwoId', 'playerTwoName', 'status', 'updatedAt']) && request.resource.data.updatedAt == request.time && isValidGame(request.resource.data);
      // Permit a Player 2 from the immediately preceding schema to leave,
      // without introducing the newer display-name fields into that document.
      allow update: if isAuthenticated() && resource.data.keys().hasOnly(['code', 'status', 'ownerId', 'playerOneId', 'playerTwoId', 'createdAt', 'updatedAt']) && resource.data.playerTwoId == request.auth.uid && resource.data.status == 'SETUP' && request.resource.data.keys().hasOnly(['code', 'status', 'ownerId', 'playerOneId', 'playerTwoId', 'createdAt', 'updatedAt']) && request.resource.data.playerTwoId == null && request.resource.data.status == 'WAITING' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerTwoId', 'status', 'updatedAt']) && request.resource.data.updatedAt == request.time;
      allow delete: if isAuthenticated() && resource.data.playerOneId == request.auth.uid && resource.data.playerTwoId == null;
    }
  }
}
