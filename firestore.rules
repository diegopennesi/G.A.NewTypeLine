rules_version = '2';
// Sprint 3: lobby, squads of 3 or 5 placeholder units, readiness and initial TL.
// Code/format/createdAt are immutable. Only the departing owner can transfer ownership.
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function participant(d) { return signed() && request.auth.uid in [d.playerOneId, d.playerTwoId]; }
  function squad(s, n) {
   return s is list && s.size() <= n && s.toSet().size() == s.size() &&
    s.hasOnly(['placeholder-1','placeholder-2','placeholder-3','placeholder-4','placeholder-5','placeholder-6','placeholder-7','placeholder-8','placeholder-9','placeholder-10','placeholder-11','placeholder-12','placeholder-13','placeholder-14','placeholder-15','placeholder-16','placeholder-17','placeholder-18']);
  }
  function valid(d) {
   let n = d.matchSize == '3v3' ? 3 : 5;
   return d.keys().hasAll(['code','matchSize','status','ownerId','playerOneId','playerOneName','playerTwoId','playerTwoName','playerOneTeam','playerTwoTeam','playerOneReady','playerTwoReady','playerOneSquad','playerTwoSquad','createdAt','updatedAt']) &&
    d.keys().hasOnly(['code','matchSize','status','ownerId','playerOneId','playerOneName','playerTwoId','playerTwoName','playerOneTeam','playerTwoTeam','playerOneReady','playerTwoReady','playerOneSquad','playerTwoSquad','createdAt','updatedAt']) &&
    d.code is string && d.code.matches('^[A-Z0-9]{8}$') &&
    d.matchSize in ['3v3','5v5'] && d.status in ['WAITING','SETUP','ACTIVE'] &&
    d.ownerId == d.playerOneId && d.playerOneId is string && d.playerOneId.size() > 0 && d.playerOneId.size() <= 128 &&
    d.playerOneName is string && d.playerOneName.size() > 0 && d.playerOneName.size() <= 64 &&
    (d.playerTwoId == null || (d.playerTwoId is string && d.playerTwoId.size() > 0 && d.playerTwoId.size() <= 128 && d.playerTwoId != d.playerOneId)) &&
    (d.playerTwoName == null || (d.playerTwoName is string && d.playerTwoName.size() > 0 && d.playerTwoName.size() <= 64)) &&
    d.playerOneReady is bool && d.playerTwoReady is bool &&
    squad(d.playerOneSquad,n) && squad(d.playerTwoSquad,n) &&
    (!d.playerOneReady || d.playerOneSquad.size() == n) && (!d.playerTwoReady || d.playerTwoSquad.size() == n) &&
    d.createdAt is timestamp && d.updatedAt is timestamp &&
    ((d.status == 'WAITING' && d.playerTwoId == null && d.playerTwoName == null && d.playerOneTeam == null && d.playerTwoTeam == null && !d.playerOneReady && !d.playerTwoReady) ||
     (d.status in ['SETUP','ACTIVE'] && d.playerTwoId != null && d.playerTwoName != null &&
      d.playerOneTeam in ['RED','BLUE'] && d.playerTwoTeam in ['RED','BLUE'] && d.playerOneTeam != d.playerTwoTeam &&
      (d.status != 'ACTIVE' || (d.playerOneReady && d.playerTwoReady))));
  }
  match /games/{code} {
   allow get: if signed() && (resource.data.status == 'WAITING' || participant(resource.data));
   allow list: if participant(resource.data);
   allow create: if signed() && valid(request.resource.data) && request.resource.data.code == code &&
    request.resource.data.ownerId == request.auth.uid && request.resource.data.status == 'WAITING' &&
    request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
   allow update: if signed() && valid(request.resource.data) && request.resource.data.updatedAt == request.time &&
    request.resource.data.code == resource.data.code && request.resource.data.matchSize == resource.data.matchSize &&
    request.resource.data.createdAt == resource.data.createdAt && (
     (resource.data.status == 'WAITING' && request.resource.data.status == 'SETUP' &&
      request.resource.data.playerTwoId == request.auth.uid &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerTwoId','playerTwoName','playerOneTeam','playerTwoTeam','updatedAt','status'])) ||
     (resource.data.status == 'SETUP' && request.auth.uid == resource.data.playerOneId &&
      (!resource.data.playerOneReady || request.resource.data.playerOneSquad == resource.data.playerOneSquad) && request.resource.data.playerOneReady &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerOneReady','playerOneSquad','status','updatedAt'])) ||
     (resource.data.status == 'SETUP' && request.auth.uid == resource.data.playerTwoId &&
      (!resource.data.playerTwoReady || request.resource.data.playerTwoSquad == resource.data.playerTwoSquad) && request.resource.data.playerTwoReady &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerTwoReady','playerTwoSquad','status','updatedAt'])) ||
     (participant(resource.data) && resource.data.status == 'SETUP' && request.resource.data.status == 'WAITING' &&
      request.resource.data.playerOneId == (request.auth.uid == resource.data.playerOneId ? resource.data.playerTwoId : resource.data.playerOneId) &&
      request.resource.data.playerOneName == (request.auth.uid == resource.data.playerOneId ? resource.data.playerTwoName : resource.data.playerOneName) &&
      request.resource.data.playerOneSquad.size() == 0 && request.resource.data.playerTwoSquad.size() == 0)
    );
   allow delete: if signed() && resource.data.ownerId == request.auth.uid && resource.data.status == 'WAITING';
  }
 }
}
